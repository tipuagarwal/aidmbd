# Copy to .env.local and fill in. Never commit real values.

# Form submissions (meeting requests from /book, course waitlists) are emailed through
# Resend (https://resend.com). Without these, submissions are logged to the console in
# development and fail visibly in production.
RESEND_API_KEY=
# Inbox that receives submissions. Separate several addresses with commas.
EMAIL_TO=
# A sender on a domain verified in Resend, e.g. "AIDMBD Website <hello@example.com>".
EMAIL_FROM=

# The public site address, used for canonical URLs, the sitemap, social images and structured
# data, e.g. "https://www.example.com". On Vercel the production domain is used if this is unset.
SITE_URL=
