# Copy to .env.local and fill in. Never commit real values.

# Booking requests from /book are emailed through Resend (https://resend.com).
# Without these, requests are logged to the console in development and fail in production.
RESEND_API_KEY=
# Inbox that receives requests. Separate several addresses with commas.
BOOKING_EMAIL_TO=
# A sender on a domain verified in Resend, e.g. "AIDMBD Website <bookings@example.com>".
BOOKING_EMAIL_FROM=
